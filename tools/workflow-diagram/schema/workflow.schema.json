{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflow-diagram.local/workflow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "$ref": "#/definitions/text" },
    "subtitle": { "type": "string" },
    "lanes": { "type": "array", "items": { "$ref": "#/definitions/lane" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "color"],
      "properties": {
        "id": { "$ref": "#/definitions/text" }, "label": { "$ref": "#/definitions/text" },
        "color": {
          "type": "object", "additionalProperties": false, "required": ["light", "dark"],
          "properties": { "light": { "$ref": "#/definitions/color" }, "dark": { "$ref": "#/definitions/color" } }
        }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "summary"],
      "properties": {
        "id": { "$ref": "#/definitions/text" }, "label": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" }, "lane": { "$ref": "#/definitions/text" },
        "kind": { "enum": ["skill", "mode", "artifact", "system"] },
        "details": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "body": { "type": "string" }, "when": { "type": "string" },
            "commands": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "text"],
                "properties": { "label": { "$ref": "#/definitions/text" }, "text": { "$ref": "#/definitions/text" } }
              }
            },
            "links": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "href"],
                "properties": { "label": { "$ref": "#/definitions/text" }, "href": { "$ref": "#/definitions/text" } }
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/definitions/text" }, "from": { "$ref": "#/definitions/text" },
        "to": { "$ref": "#/definitions/text" }, "kind": { "enum": ["primary", "loop", "optional"] },
        "label": { "type": "string" }
      }
    }
  }
}
