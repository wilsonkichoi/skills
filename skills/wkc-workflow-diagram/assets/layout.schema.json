{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflow-diagram.local/layout.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodes": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["x", "y"],
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
      }
    },
    "edges": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["start", "segments"],
        "properties": {
          "start": { "$ref": "#/definitions/point" },
          "segments": { "type": "array", "minItems": 1, "items": {
            "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" }
          } },
          "labelOffset": { "$ref": "#/definitions/point" }, "labelAngle": { "type": "number" }
        }
      }
    },
    "regions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane", "x", "y", "width", "height"],
        "properties": {
          "lane": { "type": "string", "minLength": 1 },
          "x": { "type": "number" }, "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "definitions": {
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
  }
}
