{
  "name": "workflow-diagram",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Portable, data-authored workflow diagrams with offline HTML export.",
  "exports": "./dist/workflow-diagram.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output build/preview.mjs",
    "build": "node build/standalone.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run check:assets && npm test && npm run build && npm run test:browser",
    "build:assets": "node build/assets.mjs",
    "check:assets": "node build/assets.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
